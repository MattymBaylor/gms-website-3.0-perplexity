{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/layout/**",
              "components/sales/**",
              "ui_kits/prospect_page/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|Inter|Courier Prime))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, Inter, Courier Prime."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|surface|icon|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, surface, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|outcome|positive|negative)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'outcome' | 'positive' | 'negative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:paper|night)$/]",
        "message": "<Badge> surface must be one of 'paper' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|surface|icon|iconRight|href|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, surface, icon, iconRight, href, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:paper|night)$/]",
        "message": "<Button> surface must be one of 'paper' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|surface|accent|hover|pad|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, surface, accent, hover, pad, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:paper|night)$/]",
        "message": "<Card> surface must be one of 'paper' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DepartmentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|name|summary|systems|status|surface|style|key|ref|className|style|children)$/]",
        "message": "<DepartmentCard> doesn't accept that prop. Declared props: icon, name, summary, systems, status, surface, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DepartmentCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:priority|ready|later)$/]",
        "message": "<DepartmentCard> status must be one of 'priority' | 'ready' | 'later'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DepartmentCard'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:paper|night)$/]",
        "message": "<DepartmentCard> surface must be one of 'paper' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|index|surface|align|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, index, surface, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:paper|night)$/]",
        "message": "<Eyebrow> surface must be one of 'paper' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Eyebrow> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|sub|key|ref|className|style|children)$/]",
        "message": "<FlowNode> doesn't accept that prop. Declared props: icon, label, sub."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProblemMirrorItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|problem|tag|key|ref|className|style|children)$/]",
        "message": "<ProblemMirrorItem> doesn't accept that prop. Declared props: question, problem, tag."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoadmapStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:phase|title|timeframe|description|deliverables|surface|last|style|key|ref|className|style|children)$/]",
        "message": "<RoadmapStep> doesn't accept that prop. Declared props: phase, title, timeframe, description, deliverables, surface, last, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoadmapStep'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:paper|night)$/]",
        "message": "<RoadmapStep> surface must be one of 'paper' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|index|title|lead|surface|align|maxWidth|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, index, title, lead, surface, align, maxWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:paper|night)$/]",
        "message": "<SectionHeading> surface must be one of 'paper' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCallout'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|footnote|tone|surface|align|style|key|ref|className|style|children)$/]",
        "message": "<StatCallout> doesn't accept that prop. Declared props: value, label, footnote, tone, surface, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCallout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|outcome|positive)$/]",
        "message": "<StatCallout> tone must be one of 'accent' | 'outcome' | 'positive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCallout'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:paper|night)$/]",
        "message": "<StatCallout> surface must be one of 'paper' | 'night'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCallout'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<StatCallout> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Testimonial'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|role|result|surface|style|key|ref|className|style|children)$/]",
        "message": "<Testimonial> doesn't accept that prop. Declared props: quote, name, role, result, surface, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Testimonial'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:paper|night)$/]",
        "message": "<Testimonial> surface must be one of 'paper' | 'night'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
