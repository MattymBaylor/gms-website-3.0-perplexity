# GrowthMindset.ai — environment variables
#
# Copy to `.env.local` for local dev (Next reads it automatically).
# Set the same variables in the Vercel project settings for production.

# N8N webhook that drives the "Sam Outbound" voice-agent pipeline.
# Defaults to the production URL if unset (see app/api/lead/route.ts).
N8N_WEBHOOK_URL=https://n8n.growthmindsetai.tech/webhook/44956247-3835-4500-87b4-dafc40c6b0a9

# xAI (Grok) API key for the AI Validation Panel (/saas/ai-validation-panel).
# Used server-side only by app/api/validate/route.ts — never exposed to the browser.
XAI_API_KEY=xai-…

# Optional override for the Grok model used by the validation panel.
# Defaults to "grok-4" if unset.
# XAI_MODEL=grok-4

# Optional N8N webhook for email captures from the AI Validation Panel gate.
# If unset, captures are still logged to function output (visible in Netlify Functions logs).
# Used server-side only by app/api/subscribe/route.ts.
N8N_SUBSCRIBE_WEBHOOK_URL=
